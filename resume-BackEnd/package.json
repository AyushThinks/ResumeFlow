{
  "name": "resume-api",
  "version": "1.0.0",
  "description": "REST API for ResumeFlow documents, templates, versions and application tracking",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "test": "node --test tests/app.test.js tests/models.test.js tests/rateLimit.test.js tests/validation.test.js"
  },
  "keywords": [],
  "author": "Ayush",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.5",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  }
}
